# Modele de configuration frontend. Copier en .env.local pour surcharger
# localement sans toucher aux fichiers versionnes (.env.local est ignore
# par git).
#
# Aucune de ces valeurs n'est un secret : Vite les inline dans le bundle
# JavaScript livre au navigateur. Ne jamais y placer de mot de passe, de
# cle d'API ou de secret JWT.
#
# Fichiers charges par Vite selon le mode :
#   .env              tous modes (non versionne, ignore par git)
#   .env.development  npm run dev
#   .env.production   npm run build
#   .env.local        tous modes, prioritaire (non versionne)

VITE_API_BASE_URL=http://localhost:8080/api