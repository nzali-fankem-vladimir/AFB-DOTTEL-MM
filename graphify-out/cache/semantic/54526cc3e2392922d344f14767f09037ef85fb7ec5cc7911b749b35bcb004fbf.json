{"nodes": [{"id": "claude_skills_graphify_references_query_vocab_expansion", "label": "Constrained query vocabulary expansion (Step 0)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify query matches nodes via case-folded substring + IDF with no stemming/synonyms/cross-language support, so a literal mismatch between user wording and graph labels (different language, different domain vocabulary) collapses results to noise; expanding the query against the graph's own extracted label vocabulary first (never inventing tokens) fixes this without hallucinating matches."}, {"id": "claude_skills_graphify_references_query_bfs_dfs", "label": "BFS/DFS traversal modes", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BFS (default) is best for broad 'what is X connected to' context; DFS (--dfs) traces one specific chain/dependency path as deep as possible before backtracking."}, {"id": "claude_skills_graphify_references_query_save_result_reflect", "label": "save-result / reflect work-memory loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers are saved back into the graph with an --outcome (useful/dead_end/corrected) tag so future sessions get preferred sources, skip known dead ends, and see prior corrections via LESSONS.md - a self-improving feedback loop across sessions."}, {"id": "claude_skills_graphify_references_query_path_explain", "label": "/graphify path and /graphify explain", "file_type": "code", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_graphify_references_query_vocab_expansion", "target": "claude_skills_graphify_references_query_bfs_dfs", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_bfs_dfs", "target": "claude_skills_graphify_references_query_save_result_reflect", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_path_explain", "target": "claude_skills_graphify_references_query_save_result_reflect", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "hyperedge_graphify_query_family", "label": "Graph query/traversal family (query, path, explain)", "nodes": ["claude_skills_graphify_references_query_vocab_expansion", "claude_skills_graphify_references_query_bfs_dfs", "claude_skills_graphify_references_query_path_explain", "claude_skills_graphify_references_query_save_result_reflect"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/graphify/references/query.md"}]}