{"nodes": [{"id": "claude_skills_graphify_skill_graphify", "label": "graphify skill", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns any folder of files (code, docs, papers, images, video) into a persistent, queryable knowledge graph with honest EXTRACTED/INFERRED/AMBIGUOUS audit trail and community detection, so codebase questions can be answered from a graph instead of re-scanning files each time."}, {"id": "claude_skills_graphify_skill_fast_path", "label": "Fast path (existing graph.json check)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json already exists and the request is a natural-language question, skip rebuild steps 1-5 and jump straight to query - avoids redundant re-extraction cost."}, {"id": "claude_skills_graphify_skill_step3_extraction", "label": "Step 3: Structural + semantic extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits extraction into free deterministic AST parsing for code and LLM-based semantic extraction for docs/papers/images, run in parallel to save time; avoids requiring any Anthropic API key by using the host agent itself as the LLM when no Gemini key is set."}, {"id": "claude_skills_graphify_skill_step4_build", "label": "Step 4: Build graph, cluster, analyze", "file_type": "code", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_skill_shrink_guard", "label": "Shrink-guard on graph.json export", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json() refuses to write a graph smaller than the existing one (issue #479), preventing an incomplete extraction from silently overwriting a good prior graph."}, {"id": "claude_skills_graphify_skill_step4_5_health_check", "label": "Step 4.5: Graph health check", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-destructive diagnostic surfacing edge collapse, dangling/missing endpoints, and self-loops - the silent-corruption modes of incremental updates and AST/LLM id mismatches."}, {"id": "claude_skills_graphify_skill_step5_label_communities", "label": "Step 5: Label communities", "file_type": "code", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS if unsure), never skip corpus size warnings, always show token cost, never hide cohesion scores, warn before HTML viz on >5000 node graphs - keeps the audit trail trustworthy."}], "edges": [{"source": "claude_skills_graphify_skill_graphify", "target": "claude_skills_graphify_skill_fast_path", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_graphify", "target": "claude_skills_graphify_skill_step3_extraction", "relation": "implements", "confidence": 